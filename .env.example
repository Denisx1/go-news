# Скопируйте в .env и заполните:  cp .env.example .env

# ── Общее ──────────────────────────────────────────────
POLL_INTERVAL=10m
DATA_DIR=data
# Ключевые слова через запятую; * = без фильтра
KEYWORDS=черкас,черкащин
ONLY_TODAY=true
LIMIT_PER_SOURCE=5
FEED_WORKERS=5
FETCH_WORKERS=5
BROWSER_HEADLESS=true

# ── Рерайт (Anthropic) ─────────────────────────────────
REWRITE=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
AI_WORKERS=3

# ── Публикация на cherkasy.biz ─────────────────────────
SITE_ENABLED=true
SITE_LOGIN=
SITE_PASSWORD=
SITE_RESOURCE_ID=0
SITE_LOGIN_URL=https://cherkasy.biz/login/
SITE_ADD_URL=https://cherkasy.biz/news/add/
SITE_UPLOAD_URL=https://cherkasy.biz/upload/photo-nologo/
